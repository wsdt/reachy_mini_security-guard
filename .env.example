# Reachy Mini Security Guard - Configuration
# Copy this file to .env and fill in your values

# ===================
# Required
# ===================
OPENAI_API_KEY=

# ===================
# Security Settings
# ===================
# Start with security armed (true/false)
SECURITY_ARMED=false

# Face recognition frequency in Hz (0.5-10, higher = more CPU)
SECURITY_RECOGNITION_HZ=2.0

# Confidence threshold for face matching (0.3-0.9, lower = stricter matching)
SECURITY_CONFIDENCE_THRESHOLD=0.6

# Cooldown before re-alerting for unknown faces (minutes)
SECURITY_UNKNOWN_COOLDOWN_MIN=5.0

# Cooldown before re-greeting same person (minutes)
SECURITY_GREETING_COOLDOWN_MIN=10.0

# ===================
# Optional Settings
# ===================
# Model name (default: gpt-realtime)
MODEL_NAME=gpt-realtime

# Profile to use (default uses security guard behavior)
# REACHY_MINI_CUSTOM_PROFILE=default

# ===================
# Local Vision (optional, for --local-vision flag)
# ===================
# LOCAL_VISION_MODEL=HuggingFaceTB/SmolVLM2-2.2B-Instruct
# HF_HOME=./cache
# HF_TOKEN=

# ===================
# Face Recognition Models (optional)
# ===================
# Hugging Face repo for face models (default: opencv/opencv_zoo)
# FACE_MODEL_REPO=opencv/opencv_zoo
